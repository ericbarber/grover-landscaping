{
  "name": "grover-landscaping-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e:mobile": "playwright test --config playwright.config.ts --project chromium-mobile",
    "test:e2e:chromium": "playwright test --config playwright.config.ts --project chromium-mobile --project chromium-desktop",
    "test:e2e:cross-browser": "playwright test --config playwright.config.ts e2e/browser-accessibility.spec.ts e2e/provider-invitation-progress.spec.ts e2e/yard-owner-acquisition.spec.ts",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "oidc-client-ts": "^3.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
